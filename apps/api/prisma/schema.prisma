generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  isSystem           Boolean  @default(false) @map("is_system")
  displayName        String   @default("") @map("display_name")
  registrationId     String   @default("") @map("registration_id")
  registeredAddress  String   @default("") @map("registered_address")
  operatingAddress   String   @default("") @map("operating_address")
  country            String   @default("")
  phone              String   @default("")
  website            String   @default("")
  complianceEmail    String   @default("") @map("compliance_email")
  createdAt          DateTime @default(now()) @map("created_at")
  users        User[]
  customers    Customer[]
  invitations  Invitation[]
  applications Application[]
  checklistCategories ChecklistCategory[]
  storedFiles StoredFile[]
  documents Document[]
  signatureEvidence SignatureEvidence[]
  letterhead Letterhead?
  generatedPackages GeneratedPackage[]
  segregationPolicy SegregationPolicy?
  submissions Submission[]
  reviewDecisions ReviewDecision[]
  operationsPolicy OperationsPolicy?
  deliveries Delivery[]
  applicability TenantApplicability[]
  retentionPolicies RetentionPolicy[]
  legalHolds LegalHold[]
  deletionRequests DeletionRequest[]
  companyKycProfile CompanyKycProfile?
  companyAssets TenantCompanyAsset[]
  sectionProgress ApplicationSectionProgress[]
  networkProfile CompanyNetworkProfile?
  connectionsRequested CompanyConnection[] @relation("ConnectionRequester")
  connectionsReceived CompanyConnection[] @relation("ConnectionAddressee")
  memberNetworkProfiles MemberNetworkProfile[]
  companyPosts CompanyPost[]
  companyPostComments CompanyPostComment[] @relation("CommentAuthorTenant")
  companyPostReactions CompanyPostReaction[] @relation("ReactionActorTenant")
  companyNotifications CompanyNotification[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  mfaSecret    String?    @map("mfa_secret")
  mfaEnrolledAt DateTime? @map("mfa_enrolled_at")
  displayName  String     @map("display_name")
  createdAt    DateTime   @default(now()) @map("created_at")
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  roles        UserRole[]
  sessions     Session[]
  customer     Customer?
  reviewDecisions ReviewDecision[]
  assignedApplications Application[] @relation("ApplicationAssignee")
  memberNetworkProfiles MemberNetworkProfile[]
  companyPosts CompanyPost[]
  companyPostComments CompanyPostComment[]
  companyPostReactions CompanyPostReaction[]
  companyNotifications CompanyNotification[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  mfaSatisfied Boolean   @default(false) @map("mfa_satisfied")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id") @db.Uuid
  purpose    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("audit_events")
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  userId       String?       @unique @map("user_id") @db.Uuid
  legalName    String        @map("legal_name")
  customerType String        @map("customer_type")
  createdAt    DateTime      @default(now()) @map("created_at")
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  applications Application[]

  @@index([tenantId])
  @@map("customers")
}

model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String
  legalName    String    @map("legal_name")
  customerType String    @map("customer_type")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("invitations")
}

model FormSchema {
  id         String      @id @default(uuid()) @db.Uuid
  templateId String      @map("template_id")
  version    Int
  fields     FormField[]

  @@unique([templateId, version])
  @@map("form_schemas")
}

model FormField {
  id         String     @id @default(uuid()) @db.Uuid
  schemaId   String     @map("schema_id") @db.Uuid
  fieldKey   String     @map("field_key")
  label      String
  widget     String
  repeatable Boolean    @default(false)
  options    Json?
  columns    Json?
  sortOrder  Int        @map("sort_order")
  schema     FormSchema @relation(fields: [schemaId], references: [id])

  @@unique([schemaId, fieldKey])
  @@map("form_fields")
}

model ApplicabilityRule {
  id           String  @id @default(uuid()) @db.Uuid
  customerType String  @map("customer_type")
  templateId   String  @map("template_id")
  fieldKey     String  @default("") @map("field_key")
  required     Boolean @default(true)

  @@unique([customerType, templateId, fieldKey])
  @@map("applicability_rules")
}

model TenantApplicability {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  customerType String  @map("customer_type")
  templateId   String  @map("template_id")
  required     Boolean
  tenant       Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, customerType, templateId])
  @@index([tenantId])
  @@map("tenant_applicability")
}

model RetentionPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  category      String
  retentionDays Int      @map("retention_days")
  effectiveFrom DateTime @map("effective_from") @db.Date
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, category])
  @@index([tenantId])
  @@map("retention_policies")
}

model LegalHold {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  targetType String    @map("target_type")
  targetId   String    @map("target_id") @db.Uuid
  reason     String
  releasedAt DateTime? @map("released_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("legal_holds")
}

model DeletionRequest {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  targetType  String    @map("target_type")
  targetId    String    @map("target_id") @db.Uuid
  requesterId String    @map("requester_id") @db.Uuid
  approverId  String?   @map("approver_id") @db.Uuid
  status      String
  reason      String
  createdAt   DateTime  @default(now()) @map("created_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("deletion_requests")
}

model ChecklistCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  label     String
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("checklist_categories")
}

model Application {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  schemaVersion Int      @default(1) @map("schema_version")
  status        String   @default("draft")
  documentVersion Int    @default(1) @map("document_version")
  assigneeId    String?  @map("assignee_id") @db.Uuid
  statusChangedAt DateTime @default(now()) @map("status_changed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  assignee      User?    @relation("ApplicationAssignee", fields: [assigneeId], references: [id])
  answers       Answer[]
  documents     Document[]
  signatureEvidence SignatureEvidence[]
  generatedPackages GeneratedPackage[]
  submissions   Submission[]
  deliveries    Delivery[]
  sectionProgress ApplicationSectionProgress[]

  @@index([tenantId])
  @@map("applications")
}

model ApplicationSectionProgress {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  sectionKey    String      @map("section_key")
  status        String      @default("not_started")
  schemaVersion Int         @map("schema_version")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  application   Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, sectionKey])
  @@index([tenantId])
  @@index([applicationId])
  @@map("application_section_progress")
}

model Answer {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  fieldKey      String      @map("field_key")
  value         Json
  application   Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, fieldKey])
  @@index([tenantId])
  @@map("answers")
}

model TemplateVersion {
  id              String      @id @default(uuid()) @db.Uuid
  templateId      String      @map("template_id")
  version         Int
  pageCount       Int         @map("page_count")
  sha256          String
  letterheadOwner String      @map("letterhead_owner")
  sourceFile      String      @map("source_file")
  placements      Placement[]

  @@unique([templateId, version])
  @@map("template_versions")
}

model Placement {
  id                String          @id @default(uuid()) @db.Uuid
  templateVersionId String          @map("template_version_id") @db.Uuid
  fieldKey          String          @map("field_key")
  status            String
  rect              Json?
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])

  @@unique([templateVersionId, fieldKey])
  @@map("placements")
}

model StoredFile {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  storageKey   String              @unique @map("storage_key")
  mediaType    String              @map("media_type")
  byteSize     Int                 @map("byte_size")
  sha256       String
  scanStatus   String              @map("scan_status")
  quarantinedAt DateTime?          @map("quarantined_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  documents    Document[]
  signatures   SignatureEvidence[]
  letterhead   Letterhead?
  packages     GeneratedPackage[]
  companyEvidence CompanyEvidence[]
  companyAssets TenantCompanyAsset[]
  memberNetworkPhotos MemberNetworkProfile[]

  @@index([tenantId])
  @@map("stored_files")
}

model Document {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  fieldKey      String      @map("field_key")
  fileId        String      @map("file_id") @db.Uuid
  expiresOn     DateTime?   @map("expires_on") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at")
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  application   Application @relation(fields: [applicationId], references: [id])
  file          StoredFile  @relation(fields: [fileId], references: [id])

  @@unique([applicationId, fieldKey])
  @@index([tenantId])
  @@map("documents")
}

model SignatureEvidence {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  templateId    String      @map("template_id")
  method        String
  authorisedAt  DateTime    @map("authorised_at")
  consentText   String      @map("consent_text")
  statement     String
  fileId        String      @map("file_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  application   Application @relation(fields: [applicationId], references: [id])
  file          StoredFile  @relation(fields: [fileId], references: [id])

  @@index([tenantId])
  @@map("signature_evidence")
}

model Letterhead {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @unique @map("tenant_id") @db.Uuid
  fileId    String     @unique @map("file_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  file      StoredFile @relation(fields: [fileId], references: [id])

  @@map("letterheads")
}

model GeneratedPackage {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  applicationId  String      @map("application_id") @db.Uuid
  templateId     String      @map("template_id")
  templateSha256 String      @map("template_sha256")
  version        Int
  fileId         String      @map("file_id") @db.Uuid
  painted        Json
  blocked        Json
  createdAt      DateTime    @default(now()) @map("created_at")
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  application    Application @relation(fields: [applicationId], references: [id])
  file           StoredFile  @relation(fields: [fileId], references: [id])

  @@unique([applicationId, templateId, version])
  @@index([tenantId])
  @@map("generated_packages")
}

model SegregationPolicy {
  id                          String   @id @default(uuid()) @db.Uuid
  tenantId                    String   @unique @map("tenant_id") @db.Uuid
  makerDistinctFromChecker    Boolean  @default(true) @map("maker_distinct_from_checker")
  checkerDistinctFromApprover Boolean  @default(true) @map("checker_distinct_from_approver")
  makerDistinctFromApprover   Boolean  @default(true) @map("maker_distinct_from_approver")
  tenant                      Tenant   @relation(fields: [tenantId], references: [id])

  @@map("segregation_policies")
}

model Submission {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  applicationId   String           @map("application_id") @db.Uuid
  documentVersion Int              @map("document_version")
  packageIds      Json             @map("package_ids")
  snapshot        Json?
  supersededAt    DateTime?        @map("superseded_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  application     Application      @relation(fields: [applicationId], references: [id])
  decisions       ReviewDecision[]

  @@unique([applicationId, documentVersion])
  @@index([tenantId])
  @@index([applicationId])
  @@map("submissions")
}

model ReviewDecision {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  submissionId    String     @map("submission_id") @db.Uuid
  stage           String
  outcome         String
  actorId         String     @map("actor_id") @db.Uuid
  reason          String
  evidenceIds     Json       @map("evidence_ids")
  documentVersion Int        @map("document_version")
  supersededAt    DateTime?  @map("superseded_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  submission      Submission @relation(fields: [submissionId], references: [id])
  actor           User       @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([submissionId])
  @@map("review_decisions")
}

model OperationsPolicy {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @unique @map("tenant_id") @db.Uuid
  makerHours         Int     @default(48) @map("maker_hours")
  checkerHours       Int     @default(48) @map("checker_hours")
  approverHours      Int     @default(48) @map("approver_hours")
  draftReminderDays  Int     @default(7) @map("draft_reminder_days")
  expiryLeadDays     Int     @default(30) @map("expiry_lead_days")
  escalationEmail    String  @default("") @map("escalation_email")
  tenant             Tenant  @relation(fields: [tenantId], references: [id])

  @@map("operations_policies")
}

model Delivery {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  applicationId  String      @map("application_id") @db.Uuid
  kind           String
  idempotencyKey String      @unique @map("idempotency_key")
  recipient      String
  status         String
  createdAt      DateTime    @default(now()) @map("created_at")
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  application    Application @relation(fields: [applicationId], references: [id])

  @@index([tenantId])
  @@index([applicationId])
  @@map("deliveries")
}

model CompanyKycProfile {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @unique @map("tenant_id") @db.Uuid
  status     String   @default("draft")
  reviewedAt DateTime? @map("reviewed_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  answers    CompanyKycAnswer[]
  evidence   CompanyEvidence[]
  grants     ProfileShareGrant[]

  @@map("company_kyc_profiles")
}

model CompanyKycAnswer {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  profileId String            @map("profile_id") @db.Uuid
  fieldKey  String            @map("field_key")
  value     Json
  profile   CompanyKycProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, fieldKey])
  @@index([tenantId])
  @@map("company_kyc_answers")
}

model CompanyEvidence {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  profileId    String            @map("profile_id") @db.Uuid
  documentType String            @map("document_type")
  fileId       String            @map("file_id") @db.Uuid
  issuedOn     DateTime?         @map("issued_on") @db.Date
  expiresOn    DateTime?         @map("expires_on") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at")
  profile      CompanyKycProfile @relation(fields: [profileId], references: [id])
  file         StoredFile        @relation(fields: [fileId], references: [id])

  @@index([tenantId])
  @@map("company_evidence")
}

model ProfileShareGrant {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  profileId        String            @map("profile_id") @db.Uuid
  createdById      String            @map("created_by_id") @db.Uuid
  recipientName    String            @map("recipient_name")
  recipientContact String            @map("recipient_contact")
  tokenHash        String            @unique @map("token_hash")
  accessHash       String?           @unique @map("access_hash")
  fieldKeys        Json              @map("field_keys")
  evidenceIds      Json              @map("evidence_ids")
  expiresAt        DateTime          @map("expires_at")
  accessExpiresAt  DateTime?         @map("access_expires_at")
  revokedAt        DateTime?         @map("revoked_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  profile          CompanyKycProfile @relation(fields: [profileId], references: [id])

  @@index([tenantId])
  @@map("profile_share_grants")
}

model TenantCompanyAsset {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  assetType String     @map("asset_type")
  fileId    String     @unique @map("file_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  file      StoredFile @relation(fields: [fileId], references: [id])

  @@unique([tenantId, assetType])
  @@index([tenantId])
  @@map("tenant_company_assets")
}

model CompanyNetworkProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @unique @map("tenant_id") @db.Uuid
  headline           String   @default("")
  introduction       String   @default("")
  industry           String   @default("")
  businessCategories Json     @default("[]") @map("business_categories")
  city               String   @default("")
  country            String   @default("")
  website            String   @default("")
  publicEmail        String   @default("") @map("public_email")
  publicPhone        String   @default("") @map("public_phone")
  productsServices   String   @default("") @map("products_services")
  capabilities       String   @default("")
  companySize        String   @default("") @map("company_size")
  yearEstablished    Int?     @map("year_established")
  discoverable       Boolean  @default(false)
  visibility         String   @default("private")
  messagingEnabled   Boolean  @default(true) @map("messaging_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  tenant             Tenant   @relation(fields: [tenantId], references: [id])

  @@index([discoverable, industry, country, city])
  @@map("company_network_profiles")
}

model CompanyConnection {
  id                 String              @id @default(uuid()) @db.Uuid
  requesterTenantId  String              @map("requester_tenant_id") @db.Uuid
  addresseeTenantId  String              @map("addressee_tenant_id") @db.Uuid
  tenantLowId        String              @map("tenant_low_id") @db.Uuid
  tenantHighId       String              @map("tenant_high_id") @db.Uuid
  status             String
  requestedByUserId  String              @map("requested_by_user_id") @db.Uuid
  respondedByUserId  String?             @map("responded_by_user_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  respondedAt        DateTime?           @map("responded_at")
  requesterTenant    Tenant              @relation("ConnectionRequester", fields: [requesterTenantId], references: [id])
  addresseeTenant    Tenant              @relation("ConnectionAddressee", fields: [addresseeTenantId], references: [id])
  conversation       CompanyConversation?

  @@unique([tenantLowId, tenantHighId])
  @@index([requesterTenantId, status])
  @@index([addresseeTenantId, status])
  @@map("company_connections")
}

model CompanyConversation {
  id            String           @id @default(uuid()) @db.Uuid
  connectionId  String           @unique @map("connection_id") @db.Uuid
  tenantLowId   String           @map("tenant_low_id") @db.Uuid
  tenantHighId  String           @map("tenant_high_id") @db.Uuid
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  connection    CompanyConnection @relation(fields: [connectionId], references: [id])
  messages      CompanyMessage[]

  @@index([tenantLowId])
  @@index([tenantHighId])
  @@map("company_conversations")
}

model CompanyMessage {
  id              String              @id @default(uuid()) @db.Uuid
  conversationId  String              @map("conversation_id") @db.Uuid
  senderTenantId  String              @map("sender_tenant_id") @db.Uuid
  senderUserId    String              @map("sender_user_id") @db.Uuid
  body            String
  createdAt       DateTime            @default(now()) @map("created_at")
  readAt          DateTime?           @map("read_at")
  conversation    CompanyConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderTenantId, readAt])
  @@map("company_messages")
}

model MemberNetworkProfile {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  jobTitle          String      @default("") @map("job_title")
  department        String      @default("")
  introduction      String      @default("")
  photoFileId       String?     @map("photo_file_id") @db.Uuid
  notifyMessages    Boolean     @default(true) @map("notify_messages")
  notifyConnections Boolean     @default(true) @map("notify_connections")
  notifyFeed        Boolean     @default(true) @map("notify_feed")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  user              User        @relation(fields: [userId], references: [id])
  photoFile         StoredFile? @relation(fields: [photoFileId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("member_network_profiles")
}

model CompanyPost {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  authorUserId String               @map("author_user_id") @db.Uuid
  body         String
  postType     String               @default("announcement") @map("post_type")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  author       User                 @relation(fields: [authorUserId], references: [id])
  comments     CompanyPostComment[]
  reactions    CompanyPostReaction[]

  @@index([tenantId, createdAt])
  @@index([deletedAt])
  @@map("company_posts")
}

model CompanyPostComment {
  id             String      @id @default(uuid()) @db.Uuid
  postId         String      @map("post_id") @db.Uuid
  authorTenantId String      @map("author_tenant_id") @db.Uuid
  authorUserId   String      @map("author_user_id") @db.Uuid
  body           String
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  post           CompanyPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorTenant   Tenant      @relation("CommentAuthorTenant", fields: [authorTenantId], references: [id])
  author         User        @relation(fields: [authorUserId], references: [id])

  @@index([postId, createdAt])
  @@map("company_post_comments")
}

model CompanyPostReaction {
  id            String      @id @default(uuid()) @db.Uuid
  postId        String      @map("post_id") @db.Uuid
  actorTenantId String      @map("actor_tenant_id") @db.Uuid
  actorUserId   String      @map("actor_user_id") @db.Uuid
  reactionType  String      @default("like") @map("reaction_type")
  createdAt     DateTime    @default(now()) @map("created_at")
  post          CompanyPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorTenant   Tenant      @relation("ReactionActorTenant", fields: [actorTenantId], references: [id])
  actor         User        @relation(fields: [actorUserId], references: [id])

  @@unique([postId, actorTenantId, actorUserId])
  @@index([postId])
  @@map("company_post_reactions")
}

model CompanyNotification {
  id                String    @id @default(uuid()) @db.Uuid
  recipientTenantId String    @map("recipient_tenant_id") @db.Uuid
  recipientUserId   String    @map("recipient_user_id") @db.Uuid
  type              String
  payload           Json      @default("{}")
  readAt            DateTime? @map("read_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  recipientTenant   Tenant    @relation(fields: [recipientTenantId], references: [id])
  recipientUser     User      @relation(fields: [recipientUserId], references: [id])

  @@index([recipientUserId, readAt])
  @@index([recipientTenantId, createdAt])
  @@map("company_notifications")
}
